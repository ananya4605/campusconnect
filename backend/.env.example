# Copy this file to backend/.env and fill in the values.
# Never commit the real .env file.

# MongoDB Atlas connection string (see README step 1)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campusconnect?retryWrites=true&w=majority

# Secret used to sign login tokens. Use a long random string.
JWT_SECRET=paste_a_long_random_string_here
JWT_EXPIRES=7d

PORT=5000

# Comma-separated origins allowed to call this API
CLIENT_URL=http://localhost:5173
